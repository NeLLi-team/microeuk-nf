nextflow.enable.dsl = 2

manifest {
    name = 'protist-meta-nf'
    nextflowVersion = '>=25.10.2'
}

params {
    input = null
    outdir = 'results/workflow'
    run_mode = 'full'
    run_id = null
    workflow_version = null
    source_revision = null
    execution_provenance = null

    ont_min_quality = 10
    ont_min_length = 500
    hifi_min_length = 1000
    mapping_min_mapq = 20
    rna_min_mapq = 20
    quickbin_min_identity = 0.80

    cli = null
    core_manifest = null
    checkm_manifest = null
    viral_manifest = null
    checkv_manifest = null
    annotation_manifest = null
    interpro_manifest = null
    gene_manifest = null
    braker_manifest = null
    bbtools_manifest = null

    checkeuk_app = null
    gvclass_app = null
    ssuextract_app = null

    quickclade_ref = null
    quickclade_ref_version = 'unknown'
    checkeuk_db = null
    checkeuk_db_version = 'unknown'
    gvclass_db = null
    gvclass_db_version = 'unknown'
    checkm1_db = null
    checkm1_db_version = 'unknown'
    checkm2_db = null
    checkm2_db_version = 'unknown'
    gtdbtk_db = null
    gtdbtk_db_version = 'r232'
    ssuextract_models = null
    ssuextract_db = null
    ssuextract_db_version = 'unknown'
    ssuextract_app_version = 'unknown'
    genomad_db = null
    genomad_db_version = 'unknown'
    checkv_db = null
    checkv_db_version = 'unknown'
    eggnog_db = null
    eggnog_db_version = 'unknown'
    interproscan_db = null
    interproscan_db_version = 'compatibility-unverified'
    dfam_db = null
    dfam_db_version = 'unknown'

}

includeConfig 'conf/resources.config'
includeConfig 'conf/tools.config'

process {
    shell = ["${projectDir}/.pixi/envs/default/bin/bash", '-euo', 'pipefail']
    errorStrategy = 'terminate'
    maxRetries = 0
}

profiles {
    integration {
        process.executor = 'local'
        process.maxForks = 1
    }
}

timeline.enabled = true
report.enabled = true
trace.enabled = true
dag.enabled = true
