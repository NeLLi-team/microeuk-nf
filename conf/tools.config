params.cli = "${projectDir}/bin/protist-meta"
params.core_manifest = "${projectDir}/pixi.toml"
params.bbtools_manifest = "${projectDir}/envs/bbtools/pixi.toml"
params.gene_manifest = "${projectDir}/envs/gene/pixi.toml"
params.braker_manifest = "${projectDir}/envs/gene/longrna/pixi.toml"
params.annotation_manifest = "${projectDir}/envs/annotation/pixi.toml"
params.interpro_manifest = "${projectDir}/envs/annotation/current/pixi.toml"
