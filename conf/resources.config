process {
    withLabel: qc {
        cpus   = 4
        memory = 16.GB
        time   = 2.h
    }

    withLabel: read_qc {
        cpus   = 16
        memory = 32.GB
        time   = 6.h
    }

    withName: READ_QC {
        time = { 6.h * task.attempt }
        maxRetries = 1
        errorStrategy = {
            def error = task.previousException
            def cause = error?.cause ?: error
            cause instanceof nextflow.exception.ProcessException &&
                cause.message?.startsWith('Process exceeded running time limit')
                ? 'retry'
                : 'terminate'
        }
    }

    withLabel: assembly {
        cpus   = 32
        memory = 256.GB
        time   = 24.h
    }

    withLabel: mapping {
        cpus   = 20
        memory = 96.GB
        time   = 12.h
    }

    withLabel: checkeuk {
        cpus   = 12
        memory = 96.GB
        time   = 48.h
    }

    withLabel: checkm2 {
        cpus   = 8
        memory = 64.GB
        time   = 48.h
    }

    withLabel: gvclass {
        cpus   = 20
        memory = 96.GB
        time   = 48.h
    }

    withLabel: ssu {
        cpus   = 9
        memory = 48.GB
        time   = 48.h
    }

    withLabel: viral {
        cpus   = 12
        memory = 96.GB
        time   = 24.h
    }

    withLabel: contig {
        cpus   = 3
        memory = 64.GB
        time   = 12.h
    }

    withLabel: checkm1 {
        cpus   = 16
        memory = 96.GB
        time   = 48.h
    }

    withLabel: gtdbtk {
        cpus   = 32
        memory = 256.GB
        time   = 48.h
    }

    withLabel: symclatron {
        cpus   = 16
        memory = 64.GB
        time   = 48.h
    }

    withLabel: eukqc {
        cpus   = 16
        memory = 96.GB
        time   = 24.h
    }

    withLabel: gene {
        cpus   = 16
        memory = 160.GB
        time   = 48.h
    }

    withLabel: annotation {
        cpus   = 16
        memory = 128.GB
        time   = 24.h
    }

    withLabel: report {
        cpus   = 4
        memory = 16.GB
        time   = 2.h
    }
}
